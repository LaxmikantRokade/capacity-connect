# ========================================================
# CAPACITY CONNECT - Environment Configuration Blueprint
# Smart India Hackathon 2026 • SIH26075
# ========================================================

# --------------------------------------------------------
# BACKEND (Node.js / Express Web Service)
# --------------------------------------------------------
# Port and Host (On Render / cloud hosts, PORT is injected automatically)
PORT=5001
HOST=0.0.0.0
NODE_ENV=production

# Allowed Frontend Origins for CORS (Comma-separated for multiple domains)
CLIENT_URL=https://capacityconnect.onrender.com,http://localhost:5173

# Database Connection URL:
# 1. Local SQLite: "file:./dev.db"
# 2. Render Persistent Disk (SQLite): "file:/var/data/dev.db"
# 3. Managed PostgreSQL (Render / Supabase / Neon):
DATABASE_URL="postgresql://user:password@ep-host.region.render.com/capacity_connect?sslmode=require"

# Authentication Security (Never commit production secret keys)
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# --------------------------------------------------------
# FRONTEND (React 18 + Vite Static Site)
# --------------------------------------------------------
# Public URL of the deployed backend API (omit or set to empty for local /api proxy)
VITE_API_URL=https://capacityconnect-api.onrender.com
