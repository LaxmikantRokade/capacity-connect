# ========================================================
# CAPACITY CONNECT SERVER - Production Environment
# ========================================================
PORT=5001
HOST=0.0.0.0
NODE_ENV=production
CLIENT_URL=https://capacityconnect.onrender.com,http://localhost:5173

# Database URL
DATABASE_URL="file:./dev.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql://user:password@hostname:5432/capacity_connect?sslmode=require"

# JWT Secret
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=7d
